/* pages/index/index.wxss */
.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 24rpx;
  box-sizing: border-box;
}

/* ===== 用户信息卡片 ===== */
.profile-card {
  background: linear-gradient(135deg, #0a0e27 0%, #0d1136 100%);
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.5),
    inset 0 0 40rpx rgba(59, 130, 246, 0.1);
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(77, 128, 228, 0.3);
}

.profile-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(circle at 15% 20%, rgba(96, 165, 250, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 85% 70%, rgba(59, 130, 246, 0.08) 0%, transparent 50%);
  opacity: 0.7;
  pointer-events: none;
}

.profile-header {
  display: flex;
  align-items: center;
  margin-bottom: 28rpx;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgb(218, 196, 239) 0%, rgb(165, 87, 225) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 8rpx 24rpx rgba(147, 51, 234, 0.5),
    inset 0 0 20rpx rgba(147, 51, 234, 0.3);
}

.avatar-icon {
  font-size: 56rpx;
  color: #fff;
  text-shadow: 0 0 10rpx rgba(255, 255, 255, 0.6);
}

.profile-info {
  flex: 1;
  margin-left: 24rpx;
}

.profile-name {
  display: block;
  font-size: 38rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
  text-shadow: 0 0 10rpx rgba(96, 165, 250, 0.4);
}

.profile-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
}

.edit-btn {
  padding: 16rpx;
  margin-left: 16rpx;
}

.edit-icon {
  font-size: 36rpx;
}

.profile-stats {
  display: flex;
  justify-content: space-between;
  padding-top: 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.1);
}

.stat-item {
  text-align: center;
  flex: 1;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-bottom: 8rpx;
}

.stat-value {
  display: block;
  font-size: 28rpx;
  color: #fff;
  font-weight: 600;
}

/* ===== 历史记录卡片 ===== */
.card {
  background: linear-gradient(135deg, #0a0e27 0%, #0d1136 100%);
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.5),
    inset 0 0 40rpx rgba(59, 130, 246, 0.1);
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(77, 128, 228, 0.3);
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(circle at 15% 20%, rgba(96, 165, 250, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 85% 70%, rgba(59, 130, 246, 0.08) 0%, transparent 50%);
  opacity: 0.7;
  pointer-events: none;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 28rpx;
  text-shadow: 0 0 10rpx rgba(96, 165, 250, 0.4);
}

/* 历史记录列表 */
.history-list {
  max-height: 600rpx;
  overflow-y: auto;
}

.history-item {
  padding: 24rpx;
  background: rgba(30, 41, 59, 0.6);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(77, 128, 228, 0.2);
  display: flex;
  justify-content: space-between;
  align-items: center;
  transition: all 0.2s;
}

.history-item:active {
  background: rgba(59, 130, 246, 0.15);
  transform: scale(0.98);
}

.history-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.history-date,
.history-time,
.history-location {
  font-size: 28rpx;
  color: #fff;
}

.history-time {
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
  margin-top: 4rpx;
}

.history-location {
  color: rgba(96, 165, 250, 0.8);
  font-size: 26rpx;
  margin-top: 4rpx;
}

.history-arrow {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-left: 16rpx;
}

/* 清空历史记录 */
.clear-history {
  margin-top: 24rpx;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.7);
  font-size: 28rpx;
  transition: all 0.2s;
}

.clear-history:active {
  background: rgba(255, 255, 255, 0.1);
  transform: scale(0.98);
}

/* ===== 功能菜单 ===== */
.menu-section {
  background: linear-gradient(135deg, #0a0e27 0%, #0d1136 100%);
  border-radius: 24rpx;
  padding: 36rpx;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.5),
    inset 0 0 40rpx rgba(59, 130, 246, 0.1);
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(77, 128, 228, 0.3);
}

.menu-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(circle at 15% 20%, rgba(96, 165, 250, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 85% 70%, rgba(59, 130, 246, 0.08) 0%, transparent 50%);
  opacity: 0.7;
  pointer-events: none;
}

.menu-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 28rpx;
  text-shadow: 0 0 10rpx rgba(96, 165, 250, 0.4);
}

.menu-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.menu-item {
  background: rgba(30, 41, 59, 0.6);
  border-radius: 16rpx;
  padding: 32rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(77, 128, 228, 0.2);
  transition: all 0.2s;
}

.menu-item:active {
  background: rgba(59, 130, 246, 0.15);
  transform: scale(0.96);
}

.menu-icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.menu-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
}
