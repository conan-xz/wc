/* pages/astrology-input/astrology-input.wxss */

.page-container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 24rpx;
  box-sizing: border-box;
}

.card {
  background: linear-gradient(135deg, #0a0e27 0%, #0d1136 100%);
  border-radius: 24rpx;
  padding: 36rpx;
  margin-bottom: 24rpx;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.5),
    inset 0 0 40rpx rgba(59, 130, 246, 0.1);
  position: relative;
  overflow: hidden;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(77, 128, 228, 0.3);
}

.card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background:
    radial-gradient(circle at 15% 20%, rgba(96, 165, 250, 0.1) 0%, transparent 50%),
    radial-gradient(circle at 85% 70%, rgba(59, 130, 246, 0.08) 0%, transparent 50%);
  opacity: 0.7;
  pointer-events: none;
}

.card-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 36rpx;
  text-align: center;
  text-shadow: 0 0 10rpx rgba(96, 165, 250, 0.4);
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-bottom: 16rpx;
  font-weight: 500;
}

.picker {
  width: 100%;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(77, 128, 228, 0.3);
  border-radius: 16rpx;
  background: rgba(15, 23, 42, 0.6);
  font-size: 28rpx;
  color: #e0e7ff;
  box-sizing: border-box;
  backdrop-filter: blur(10rpx);
}

.picker:active {
  background: rgba(30, 41, 59, 0.8);
  transform: scale(0.98);
}

.time-warning {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  background: rgba(251, 191, 36, 0.1);
  border-radius: 16rpx;
  border: 1rpx solid rgba(251, 191, 36, 0.2);
}

.warning-icon {
  margin-right: 12rpx;
  font-size: 28rpx;
}

.warning-text {
  font-size: 26rpx;
  color: #fbbf24;
  font-weight: 500;
}

.location-input-wrapper {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.form-input {
  flex: 1;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(77, 128, 228, 0.3);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #e0e7ff;
  background: rgba(15, 23, 42, 0.6);
  box-sizing: border-box;
  backdrop-filter: blur(10rpx);
}

.form-input:focus {
  border-color: rgba(96, 165, 250, 0.6);
  box-shadow: 0 0 12rpx rgba(59, 130, 246, 0.3);
}

.search-btn {
  padding: 24rpx 40rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.3),
    0 0 24rpx rgba(59, 130, 246, 0.4),
    inset 0 0 12rpx rgba(255, 255, 255, 0.2);
  transition: all 0.3s;
}

.search-btn:active {
  transform: translateY(2rpx);
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.2),
    0 0 16rpx rgba(59, 130, 246, 0.3);
}

.city-results {
  margin-top: 20rpx;
  max-height: 400rpx;
  overflow-y: auto;
  background: rgba(15, 23, 42, 0.8);
  border-radius: 16rpx;
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.5),
    inset 0 0 20rpx rgba(59, 130, 246, 0.1);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(77, 128, 228, 0.2);
}

.city-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  transition: all 0.2s;
}

.city-item:active {
  background: rgba(59, 130, 246, 0.1);
  transform: scale(0.98);
}

.city-item:last-child {
  border-bottom: none;
}

.city-info {
  flex: 1;
}

.city-name {
  display: block;
  font-size: 30rpx;
  color: #fff;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.city-detail {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.city-coords {
  text-align: right;
}

.coords-text {
  font-size: 24rpx;
  color: rgba(96, 165, 250, 0.8);
}

.selected-location {
  margin-top: 20rpx;
  padding: 24rpx;
  background: rgba(30, 41, 59, 0.7);
  border-radius: 16rpx;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(77, 128, 228, 0.2);
}

.location-info {
  display: flex;
  align-items: center;
}

.location-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
  color: #60a5fa;
  text-shadow: 0 0 10rpx rgba(96, 165, 250, 0.5);
}

.location-detail {
  flex: 1;
}

.location-city {
  display: block;
  font-size: 30rpx;
  color: #fff;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.location-coords {
  display: block;
  font-size: 26rpx;
  color: rgba(96, 165, 250, 0.8);
}

.timezone-display {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: rgba(30, 41, 59, 0.7);
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #fff;
  font-weight: 500;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(77, 128, 228, 0.2);
}

.timezone-name {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.history-list {
  max-height: 500rpx;
  overflow-y: auto;
}

.history-item {
  padding: 24rpx;
  background: rgba(30, 41, 59, 0.6);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(77, 128, 228, 0.2);
  transition: all 0.2s;
}

.history-item:active {
  background: rgba(59, 130, 246, 0.15);
  transform: scale(0.98);
}

.history-info {
  display: flex;
  flex-direction: column;
}

.history-date,
.history-time,
.history-location {
  font-size: 28rpx;
  color: #fff;
}

.history-time {
  color: rgba(255, 255, 255, 0.7);
  font-size: 26rpx;
}

.history-location {
  color: rgba(96, 165, 250, 0.8);
  font-size: 26rpx;
}

/* 按钮样式 */
.btn {
  display: block;
  width: 100%;
  padding: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  box-sizing: border-box;
  cursor: pointer;
  transition: all 0.3s;
}

.btn-primary {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  color: #fff;
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.3),
    0 0 24rpx rgba(59, 130, 246, 0.4),
    inset 0 0 12rpx rgba(255, 255, 255, 0.2);
}

.btn-primary:active {
  transform: translateY(2rpx);
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.2),
    0 0 16rpx rgba(59, 130, 246, 0.3);
}

.btn-block {
  display: block;
  width: 100%;
}

.btn-large {
  padding: 36rpx;
  font-size: 36rpx;
}